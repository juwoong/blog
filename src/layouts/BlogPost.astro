---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Callout from '../components/Callout.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ViewCounter from '../components/ViewCounter.astro';
import { formatTagDescription, getTranslations, type LanguageCode } from '../i18n';

interface Props {
	title: string;
	titleImage?: ImageMetadata;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	ogImage?: ImageMetadata;
	tags?: string[];
	aside?: string;
	location?: string;
	lang?: LanguageCode;
	viewKey?: string;
	originalArticleUrl?: string;
	publish?: boolean;
	series?: {
		slug: string;
		title: string;
		order: number;
		description?: string;
	};
}

const {
	title,
	titleImage,
	description,
	pubDate,
	updatedDate,
	heroImage,
	ogImage,
	tags,
	aside,
	location,
	lang = 'ko',
	viewKey,
	originalArticleUrl,
	publish = true,
	series,
} = Astro.props;
const t = getTranslations(lang);
const tagDescription = tags && tags.length > 0 ? formatTagDescription(tags, lang) : undefined;
const hasPostMeta = tagDescription || viewKey || originalArticleUrl;
const isTranslation = tags?.includes('translation') ?? false;
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} image={ogImage ?? heroImage} pubDate={pubDate} tags={tags} location={location} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
				padding-top: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				color: rgb(var(--gray-dark));
			}
			.prose > :global(iframe) {
				display: block;
				width: min(100%, 560px);
				height: auto;
				aspect-ratio: 16 / 9;
				margin: 2em auto;
				border: 0;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 2em;
				font-weight: 600;
				color: rgb(var(--black));
			}
			.post-labels {
				display: flex;
				justify-content: center;
				gap: 0.5rem;
				margin-bottom: 0.75rem;
			}
			.post-label {
				display: inline-block;
				padding: 0.25rem 0.6rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				color: rgb(var(--gray));
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.08em;
				line-height: 1.4;
				text-decoration: none;
			}
			.draft-badge {
				border-color: #b33a3a;
				color: #b33a3a;
			}
			.series-badge:hover {
				border-color: rgb(var(--gray));
				color: rgb(var(--black));
			}
			.title-image {
				display: block;
				width: min(100%, 388px);
				height: auto;
				margin: 0 auto;
				border-radius: 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray-date));
			}
			.last-updated-on {
				font-style: italic;
			}
			.post-meta {
				display: inline-flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				align-items: center;
				justify-content: center;
				margin-top: 0.5em;
				color: rgb(var(--gray));
				font-size: 1em;
				line-height: 1.4;
			}
			.meta-separator {
				color: rgb(var(--gray-date));
			}
			.original-article {
				color: rgb(var(--gray));
			}
			.original-article:hover {
				color: rgb(var(--black));
			}
			.post-aside {
				margin-top: 3rem;
				padding: 0.85rem 1rem;
				border-radius: 0.4rem;
				background: rgb(var(--gray-light) / 0.32);
				color: rgb(var(--gray));
				font-size: 0.9rem;
				line-height: 1.7;
			}
			.post-aside h2 {
				margin: 0 0 0.35rem;
				color: rgb(var(--gray-date));
				font-size: 0.72rem;
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.post-aside p {
				margin: 0;
				white-space: pre-line;
			}
			@media (max-width: 720px) {
				.title h1 {
					font-size: 1.8em;
				}
			}
		</style>
	</head>

	<body>
		<Header lang={lang} />
		<main>
			<article>
				<div class="prose">
					<div class="title">
						{
							(!publish || series) && (
								<div class="post-labels">
									{!publish && <span class="post-label draft-badge">DRAFT</span>}
									{series && <a class="post-label series-badge" href={`${lang === 'en' ? '/en' : ''}/series/#${series.slug}`}>{series.title} · {t.ui.seriesPart.replace('{order}', String(series.order))}</a>}
								</div>
							)
						}
						<h1>
							{
								titleImage ? (
									<img class="title-image" src={titleImage.src} width={titleImage.width} height={titleImage.height} alt={title} />
								) : (
									title
								)
							}
						</h1>
						<div class="date">
							<FormattedDate date={pubDate} lang={lang} />
							{
								updatedDate && (
									<div class="last-updated-on">
										{t.ui.lastUpdatedOn} <FormattedDate date={updatedDate} lang={lang} />
									</div>
								)
							}
						</div>
						{
							hasPostMeta && (
								<div class="post-meta">
									{tagDescription && <span>{tagDescription}</span>}
									{tagDescription && (viewKey || originalArticleUrl) && <span class="meta-separator">|</span>}
									{viewKey && <ViewCounter viewKey={viewKey} label={t.ui.views} />}
									{viewKey && originalArticleUrl && <span class="meta-separator">|</span>}
									{
										originalArticleUrl && (
											<a class="original-article" href={originalArticleUrl} target="_blank" rel="noopener noreferrer">
												{t.ui.originalArticle}
											</a>
										)
									}
								</div>
							)
						}
					</div>
					{
						isTranslation && (
							<Callout title={t.ui.translationDisclaimerTitle}>
								<p>
									{t.ui.translationDisclaimer}{' '}
									{originalArticleUrl ? (
										<>
											{t.ui.translationDisclaimerSource}{' '}
											<a href={originalArticleUrl} target="_blank" rel="noopener noreferrer">
												{t.ui.originalArticle}
											</a>
										</>
									) : (
										t.ui.translationDisclaimerSource
									)}
								</p>
							</Callout>
						)
					}
					<slot />
					{
						aside && (
							<aside class="post-aside" role="note">
								<h2>{t.ui.aside}</h2>
								<p>{aside}</p>
							</aside>
						)
					}
				</div>
			</article>
		</main>
		<Footer lang={lang} />
	</body>
</html>
